{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system",
    "mode": "dark"
  },
  "keybinds": {
    "app.exit": "<leader>q"
  },
  "diffs": {
    "wrap": "word",
    "tree": true
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide"
  },
  "animations": true,
  "tabs": {
    "enabled": false
  }
}
